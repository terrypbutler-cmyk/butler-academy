# Copy this file to `.streamlit/secrets.toml` for local development.
# Never commit the real secrets file.
GEMINI_API_KEY = "replace-me"
OPENAI_API_KEY = "replace-me"
ELEVENLABS_API_KEY = "replace-me"

# Optional: enables explicit server-side saving from the Seating Plan page.
# Replace this with an approved durable path or managed storage mount in production.
SEATING_PLAN_STORAGE_PATH = ".data/seating_plans.json"
